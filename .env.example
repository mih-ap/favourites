# --- docker compose: где vault и куда публиковать веб -------------------------
# Каталог Obsidian-vault на хосте: сюда пишутся карточки (library/<YYYY-MM>/).
# В контейнере он виден как /vault.
FAV_VAULT_DIR=./vault
# Имя vault в ссылках obsidian://open?vault=<имя>: имя папки, открытой в Obsidian.
FAV_VAULT_NAME=vault
# Адрес и порт веб-справочника на хосте. 127.0.0.1 — только с этой машины,
# 0.0.0.0 или IP интерфейса — для локальной сети.
FAV_BIND=127.0.0.1
FAV_PORT=8090

# --- telegram ----------------------------------------------------------------
# Токен бота из @BotFather (обязателен для работы бота)
FAV_TELEGRAM_TOKEN=

# Кому можно пользоваться ботом: id чатов через запятую. Пусто = любой.
# Свой id бот покажет в ответ на сообщение, если чат не разрешён.
FAV_ALLOWED_CHATS=

# Публичный адрес веб-справочника — для ссылок в уведомлениях бота и в _index.md
FAV_PUBLIC_URL=http://localhost:8090

# --- пути (нужны только для запуска без docker, из .venv) --------------------
# FAV_VAULT=/home/user/Obsidian/Brain
# FAV_DATA_DIR=./data
# FAV_ASR_MODEL_DIR=./data/models
# FAV_ASR_TMP_DIR=./data/tmp

# --- модель ------------------------------------------------------------------
# Любой OpenAI-совместимый endpoint: LiteLLM, OpenRouter, Ollama, vLLM.
FAV_LLM_BASE_URL=https://litellm.cdek.tech/v1
FAV_LLM_MODEL=deepseek-v4.1-flash
FAV_LLM_API_KEY=
# Потолок входного текста в токенах (обрезаем транскрипты и статьи)
FAV_LLM_MAX_INPUT=14000
FAV_LLM_TIMEOUT=180

# --- извлечение --------------------------------------------------------------
# Instagram отдаёт контент только с cookies: экспортируйте cookies.txt (Netscape)
# из браузера и положите по этому пути.
FAV_COOKIES_FILE=./data/instagram-cookies.txt
# Ниже этого порога «содержания» (символы без «Video by», хештегов и дублей)
# модель не зовут — карточка помечается partial вместо выдуманного пересказа.
FAV_MIN_SUBSTANCE=200
FAV_MAX_ATTEMPTS=3

# --- расшифровка звука (faster-whisper, CPU) ----------------------------------
# Модель small: ~0.27 от длительности ролика на двух потоках, ~1.1 ГБ RAM на пике.
FAV_ASR_ENABLED=1
# tiny | base | small | medium — small минимально приемлемое качество для русского
FAV_ASR_MODEL=small
FAV_ASR_COMPUTE=int8
FAV_ASR_THREADS=2
# Ролики длиннее этого не расшифровываем (секунды)
FAV_ASR_MAX_SECONDS=600

# --- фото постов -------------------------------------------------------------
# Фото и карусели скачиваются в vault рядом с карточкой и вставляются в заметку.
FAV_IMAGES=1
# Сколько картинок максимум брать из одного поста
FAV_IMAGES_MAX=20
# Предельный размер одного файла, байт (12 МБ)
FAV_IMAGE_MAX_BYTES=12582912
